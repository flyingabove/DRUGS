{
  "mcpServers": {
    "biocontext-kb": {
      "command": "uvx",
      "args": ["biocontext_kb@latest"],
      "env": { "MCP_ENVIRONMENT": "DEVELOPMENT" }
    },
    "gget-mcp": {
      "command": "uvx",
      "args": ["--from", "gget-mcp@latest", "stdio"]
    },
    "patent-mcp-server": {
      "command": "uvx",
      "args": ["--with", "mcp<2", "patent-mcp-server"]
    }
  },
  "_disabled_needs_node_24": {
    "chembl-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/chembl-mcp-server@0.2.4"],
      "env": { "MCP_TRANSPORT_TYPE": "stdio" }
    },
    "pubchem-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/pubchem-mcp-server@0.6.1"],
      "env": { "MCP_TRANSPORT_TYPE": "stdio" }
    }
  }
}
